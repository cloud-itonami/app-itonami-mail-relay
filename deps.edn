;; app-mail-relay —— relay.itonami.cloud の受信箱アカウント面 + 送受信の経路。
;;
;; 判断だけを持つ層は 3 つ:
;;   mail-relay.account  1 アカウントをどうするか（開く・閉じる・鍵を回す）
;;   mail-relay.inbound  受けた 1 通をどうするか（persona.relay を保管に写す）
;;   mail-relay.send     出す 1 通をどうするか（From は persona が決める）
;;
;; IO は持たない。SMTP・Email Routing・Resend・R2・kotobase の pin は
;; すべて host（Cloudflare Worker）側の機構で、CLJS 側の
;; mail-relay.worker / .resend / .seal がそこを繋ぐ。
{:paths ["src"]
 :deps {
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       org.clojure/clojure {:mvn/version "1.12.0"}
        ;; 1 通ごとの振り分けと、返信の From の決定。
        io.github.kotoba-lang/persona
        {:git/url "https://github.com/kotoba-lang/persona.git"
         :git/sha "5b3ca005231c3f1150aaf2960d9af5ffc8b20866"}
        ;; 可搬なメールモデル（address / message / draft / send-effect）。
        io.github.kotoba-lang/mail
        {:git/url "https://github.com/kotoba-lang/mail.git"
         :git/sha "f42d319d715d9e8022238b5c48bc3485d42e2f03"}
        ;; 各 root の糸（source chain）。予算をサーバの台帳ではなく糸から数える
        ;; （ADR-2610101117 の 3）。IPLD / CBOR は chain の deps から来る。
        io.github.kotoba-lang/chain
        {:git/url "https://github.com/kotoba-lang/chain.git"
         :git/sha "6a06f8c5b2eba1dc7dec8f0be0bffa20a9d312e5"}
        ;; 承認済みの mail/send effect -> provider request（:resend / :ses / :smtp）。
        io.github.kotoba-lang/mailer
        {:git/url "https://github.com/kotoba-lang/mailer.git"
         :git/sha "9358664bfb5c5cc7a5d809c59fc12a97e8c0b1c5"}}
 :aliases
 {;; west checkout の中で開発するとき。
  :local {:override-deps
          {io.github.kotoba-lang/persona {:local/root "../../kotoba-lang/persona"}
           io.github.kotoba-lang/word-id {:local/root "../../kotoba-lang/word-id"}
           io.github.kotoba-lang/mail    {:local/root "../../kotoba-lang/mail"}
           io.github.kotoba-lang/mailer  {:local/root "../../kotoba-lang/mailer"}
           io.github.kotoba-lang/chain   {:local/root "../../kotoba-lang/chain"}}}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}}}
