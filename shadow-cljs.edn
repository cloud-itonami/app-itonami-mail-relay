;; Worker のビルド。west checkout の中の兄弟 repo を source-path で直接読む
;; —— `:local/root` と同じ理由で、pin を跨いだ編集がその場で効く。
{:source-paths
 ["src"
  "../../kotoba-lang/persona/src"
  "../../kotoba-lang/word-id/src"
  "../../kotoba-lang/mail/src"
  "../../kotoba-lang/mailer/src"
  "../../kotoba-lang/org-ietf-mime/src"
  "../../kotoba-lang/envelope/src"
  "../../kotoba-lang/org-signal/src"
  ;; 糸（mail-relay.ito）—— kotoba-lang/chain と、それが要る IPLD・CBOR・SHA-256。
  "../../kotoba-lang/chain/src"
  "../../kotoba-lang/io-ipld/src"
  "../../kotoba-lang/io-multiformats/src"
  "../../kotoba-lang/org-ietf-cbor/src"
  "../../kotoba-lang/bytes/src"
  "../../kotoba-lang/org-nist-sha2/src"
  "../../kotoba-lang/io/src"
  "../../kotoba-lang/kotoba-io-reader/src"
  "../../kotoba-lang/kotoba-io-writer/src"
  "../../kotoba-lang/kotoba-io-buffer-writer/src"
  "../../kotoba-lang/kotoba-io-put/src"
  "../../kotoba-lang/kotoba-io-byte-buffer/src"
  "../../kotoba-lang/kotoba-io-copy/src"
  "../../kotoba-lang/kotoba-io-len/src"
  "../../kotoba-lang/kotoba-io-reader-buffer/src"
  "../../kotoba-lang/kotoba-io-to-bytes/src"
  "../../kotoba-lang/kotoba-io-reader-seq/src"
  ;; 布（relay の網）—— kotoba-lang/nuno と、その keyspace の kad-dht。
  "../../kotoba-lang/nuno/src"
  "../../kotoba-lang/io-libp2p-specs-kad-dht/src"]
 :dependencies []
 :builds
 {:worker {:target :esm
           :output-dir "out"
           :compiler-options {:parallel-build false}
           :modules {:worker {:exports {default mail-relay.worker/handler}}}}}}
