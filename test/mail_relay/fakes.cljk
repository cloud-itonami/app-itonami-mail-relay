(ns mail-relay.fakes
  "Cloudflare の binding の偽物。**crypto は偽らない** —— 封も Ed25519 も
  Svix の HMAC も本物が走る。偽るのは KV・R2・fetch だけ。

  R2 は `onlyIf` を実装してある。Resend の再送を冪等にしているのは R2 の
  条件付き put なので、そこを無視する偽物で試すと、冪等性のテストが
  『常に取得できる lease』を試すだけになり、何も主張しない。"
  (:require [kotoba.lang.text :as str]
            [envelope.seal :as eseal]
            [kotoba.signal.x25519 :as x25519]
            [mail-relay.authz :as authz]
            [mail-relay.ito :as ito]
            [mail-relay.worker :as worker]))

(defn kv []
  (let [m (atom {})]
    #js {:get (fn [k & _] (js/Promise.resolve (get @m k)))
         :put (fn [k v] (swap! m assoc k v) (js/Promise.resolve nil))}))

(defn- object [v etag]
  #js {:etag etag
       :text (fn [] (js/Promise.resolve
                     (if (string? v)
                       v
                       (apply str (map #(js/String.fromCharCode %) (array-seq v))))))
       :json (fn [] (js/Promise.resolve (js/JSON.parse v)))
       :arrayBuffer (fn [] (js/Promise.resolve (.-buffer ^js v)))})

(defn r2 []
  (let [m (atom {})                       ; key -> [value etag]
        n (atom 0)]
    #js {:put (fn [k v & [^js opts]]
                (let [^js only-if (some-> opts .-onlyIf)
                      existing (get @m k)
                      no-match (some-> only-if .-etagDoesNotMatch)
                      must-match (some-> only-if .-etagMatches)]
                  (cond
                    ;; 「存在しないときだけ」
                    (and (= "*" no-match) existing) (js/Promise.resolve nil)
                    ;; 「この etag のときだけ」
                    (and must-match (not= must-match (second existing)))
                    (js/Promise.resolve nil)
                    :else
                    (let [etag (str "e" (swap! n inc))]
                      (swap! m assoc k [v etag])
                      (js/Promise.resolve #js {:etag etag})))))
         :get (fn [k] (js/Promise.resolve
                       (when-let [[v etag] (get @m k)] (object v etag))))
         :list (fn [^js opts]
                 (js/Promise.resolve
                  #js {:objects (to-array (map (fn [k] #js {:key k})
                                               (sort (filter #(str/starts-with? % (.-prefix opts))
                                                             (keys @m)))))}))}))

(defn resend-send-ok
  "`POST https://api.resend.com/emails` の応答。"
  []
  (fn [_url _init]
    (js/Promise.resolve #js {:ok true :status 200
                             :json (fn [] (js/Promise.resolve #js {:id "re_msg_1"}))})))

(defn resend-receiving
  "Receiving API と生メッセージのダウンロードを両方引き受ける fetch。"
  [{:keys [email-id to from raw]}]
  (fn [url _init]
    (cond
      (str/includes? url (str "/emails/receiving/" email-id))
      (js/Promise.resolve
       #js {:ok true :status 200
            :json (fn [] (js/Promise.resolve
                          #js {:id email-id
                               :from from
                               :to (to-array to)
                               :created_at "2026-08-28T00:00:00Z"
                               :raw #js {:download_url "https://raw.resend.test/msg"}}))})

      (str/includes? url "raw.resend.test")
      (js/Promise.resolve
       #js {:ok true :status 200
            :headers #js {:get (fn [_] (str (count raw)))}
            :body (let [bytes (js/Uint8Array.from
                               (clj->js (mapv #(.charCodeAt raw %) (range (count raw)))))
                        sent (atom false)]
                    #js {:getReader
                         (fn []
                           #js {:read (fn []
                                        (js/Promise.resolve
                                         (if @sent
                                           #js {:done true}
                                           (do (reset! sent true)
                                               #js {:done false :value bytes}))))
                                :cancel (fn [_] (js/Promise.resolve nil))})})})

      :else (js/Promise.reject (js/Error. (str "unexpected fetch: " url))))))

(defn env [& {:as over}]
  (let [e #js {:RELAY_DIR (kv) :MAIL_BUCKET (r2)}]
    (doseq [[k v] over] (aset e (name k) v))
    e))

(defn request [method path & {:keys [body headers raw-body]}]
  (js/Request. (str "https://relay.itonami.cloud" path)
               (clj->js (cond-> {:method (str/upper (name method))
                                 :headers (or headers {})}
                          raw-body (assoc :body raw-body)
                          body (assoc :body (js/JSON.stringify (clj->js body)))))))

(defn binary
  "テストの入力を、Worker が実際に渡すもの —— 1 文字 1 バイトの文字列 —— に揃える。"
  [s]
  (apply str (map #(js/String.fromCharCode %) (array-seq (.encode (js/TextEncoder.) s)))))

(defn message-to [address]
  (binary (str "Authentication-Results: relay.itonami.cloud; spf=pass; dkim=pass; dmarc=pass\r\n"
               "From: Offers <offers@example.com>\r\n"
               "To: " address "\r\n"
               "Subject: hello\r\n"
               "Content-Type: text/plain; charset=utf-8\r\n"
               "\r\n"
               "本文\r\n")))

;; ------------------------------------------------- 署名と invite
;; crypto は本物。Ed25519 の鍵を作り、本物の署名で POST /v1/invites を通す。

(defn b58-encode
  "テスト側の独立実装。`root-auth/b58-decode` と同じ表を、逆向きに。"
  [bytes]
  (let [alpha "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"
        digits (array 0)]
    (doseq [b bytes]
      (let [carry (atom b)]
        (dotimes [i (alength digits)]
          (let [x (+ (bit-shift-left (aget digits i) 8) @carry)]
            (aset digits i (mod x 58))
            (reset! carry (js/Math.floor (/ x 58)))))
        (while (pos? @carry)
          (.push digits (mod @carry 58))
          (swap! carry #(js/Math.floor (/ % 58))))))
    (str (apply str (repeat (count (take-while zero? bytes)) "1"))
         (apply str (map #(nth alpha %) (reverse (array-seq digits)))))))

(defn ed25519-did []
  (-> (js/crypto.subtle.generateKey #js {:name "Ed25519"} true #js ["sign" "verify"])
      (.then (fn [^js kp]
               (-> (js/crypto.subtle.exportKey "raw" (.-publicKey kp))
                   (.then (fn [ab]
                            {:kp kp
                             :did (str "did:key:z"
                                       (b58-encode (concat [0xed 0x01]
                                                           (array-seq (js/Uint8Array. ab)))))})))))))

(defn sign-b64 [^js kp message]
  (-> (js/crypto.subtle.sign #js {:name "Ed25519"} (.-privateKey kp)
                             (.encode (js/TextEncoder.) message))
      (.then (fn [ab] (eseal/b64url (js/Uint8Array. ab))))))

(defn now-s [] (js/Math.floor (/ (.now js/Date) 1000)))

(defn signed-headers
  "root / inviter の署名ヘッダを、本物の Ed25519 で作る。"
  [^js kp did method path]
  (let [ts (now-s)
        nonce (str "n-" (random-uuid))
        msg (authz/challenge-string {:method method :path path :timestamp ts :nonce nonce})]
    (.then (sign-b64 kp msg)
           (fn [sig] {"x-relay-root" did "x-relay-signature" sig
                      "x-relay-timestamp" (str ts) "x-relay-nonce" nonce}))))

(defn b64url-bytes [^js u8] (eseal/b64url u8))

(defn client
  "糸を自分で持つ利用者。Ed25519 の鍵は本物で、entry 1 つごとに署名する。

  -> Promise<atom {:did :kp :blocks {cid Uint8Array} :sigs {cid sig} :head cid}>"
  []
  (.then (ed25519-did)
         (fn [{:keys [kp did]}] (atom {:did did :kp kp :blocks {} :sigs {} :head nil}))))

(defn append!
  "糸に entry を 1 つ積んで署名する。`prev` を渡すと、その位置から積む
  （分岐を作るテスト用）。-> Promise<cid>"
  ([c state] (append! c state (:head @c)))
  ([c state prev]
   (let [put! (fn [cid bytes] (swap! c assoc-in [:blocks cid] bytes))
         get-fn (fn [cid] (get-in @c [:blocks cid]))
         cid (ito/append! put! get-fn prev (:did @c) state)]
     (.then (sign-b64 (:kp @c) (ito/signing-message cid))
            (fn [sig]
              (swap! c #(-> % (assoc-in [:sigs cid] sig) (assoc :head cid)))
              cid)))))

(defn ito-body
  "依頼に添える糸。`also` は他人の entry（招く側の invite など）。"
  [c & also]
  (let [all (cons @c (map deref also))]
    {:head (:head @c)
     :blocks (into {} (for [m all [cid b] (:blocks m)] [cid (b64url-bytes b)]))
     :sigs (into {} (for [m all [cid sig] (:sigs m)] [cid sig]))}))

(defn world
  "招く側と招かれる側、招く側だけが許可リストに載った env、そして invite。

  -> Promise<{:env :inviter :me :invite}>"
  [{:keys [inboxes] :or {inboxes 1}} & over]
  (-> (js/Promise.all #js [(client) (client)])
      (.then (fn [arr]
               (let [[inviter me] (vec arr)
                     e (apply env :RELAY_INVITER_ROOTS (:did @inviter) over)
                     now (.now js/Date)]
                 (.then (append! inviter {"type" "invite/issue" "at" now
                                          "invitee" (:did @me) "inboxes" inboxes
                                          "expires" (+ now 3600000)})
                        (fn [invite] {:env e :inviter inviter :me me :invite invite})))))))

(defn open-inbox
  "inbox/open を積んで POST /v1/inboxes。-> Promise<Response>"
  [{:keys [env inviter me invite]} origin]
  (let [{:keys [pub]} (x25519/generate-keypair)]
    (.then (append! me {"type" "inbox/open" "at" (.now js/Date) "invite" invite})
           (fn [_]
             (worker/handle-fetch
              (request :post "/v1/inboxes" :body {:root (:did @me)
                                                  :pub (eseal/b64url pub)
                                                  :origin origin
                                                  :ito (ito-body me inviter)})
              env)))))

(defn send-body
  "mail/send を積み、送信の本文に糸を添える。-> Promise<body>"
  [me body]
  (.then (append! me {"type" "mail/send" "at" (.now js/Date)
                      "to" (vec (concat (:to body) (:cc body)))})
         (fn [_] (assoc body :ito (ito-body me)))))
