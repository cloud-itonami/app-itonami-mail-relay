(ns mail-relay.worker-test
  "Worker のテスト。Cloudflare の binding は偽物だが、**crypto は本物**
  —— Ed25519 の署名検証も、封も、実物が走る。

  主張は 4 つ:
  1. route 表と dispatch がずれない
  2. root は署名でしか通らない（DID を知っているだけでは通らない）
  3. 受けて封じて index が引ける
  4. 出せる。From は persona が決めたものになる"
  (:require [cljs.test :as t :refer [deftest is testing async]]
            [kotoba.lang.text :as str]
            [envelope.seal :as eseal]
            [kotoba.signal.x25519 :as x25519]
            [mail-relay.api :as api]
            [mail-relay.authz :as authz]
            [mail-relay.fakes :as fakes]
            [mail-relay.ito :as ito]
            [mail-relay.root-auth :as root-auth]
            [mail-relay.worker :as worker]))

(def json-of #(.json ^js %))
(defn- ->clj [^js o] (js->clj o :keywordize-keys true))
(def req fakes/request)
(def fake-env fakes/env)
(def message-to fakes/message-to)

;; ------------------------------------------------------- 表と dispatch

(deftest the-route-table-and-the-dispatch-cannot-drift
  (testing "表の op と handler の鍵が一致する"
    (is (= (set (map :op api/routes)) (set (keys worker/ops)))
        (str "表にあって handler が無い: " (remove (set (keys worker/ops)) (map :op api/routes))
             " / handler があって表に無い: " (remove (set (map :op api/routes)) (keys worker/ops)))))
  (testing "表に無い path は 404 で、表が唯一の入口だと言う"
    (async done
      (-> (worker/handle-fetch (req :get "/v1/nope") (fake-env))
          (.then (fn [^js r] (is (= 404 (.-status r))) (json-of r)))
          (.then (fn [b] (is (= "no-such-route" (.-error b))) (done)))))))

;; --------------------------------------------------------------- did:key

(deftest did-key-decoding-agrees-with-an-outside-implementation
  ;; base58btc は自前実装なので、外の実装が同意する 1 点で固定する。
  ;; 下の DID は python の base58 で作った [0xed 0x01] + 0..31。
  (testing "既知の did:key から公開鍵のバイト列がそのまま戻る"
    (is (= (vec (range 32))
           (vec (array-seq
                 (root-auth/parse-did-key
                  "did:key:z6MkeTGwHmLmuCmgg4ABYhzWVh6ZX7hTwWt8gguAretUfc9c"))))))

  (testing "署名鍵でないもの・壊れたものは nil。読めるものを全部通さない"
    (is (nil? (root-auth/parse-did-key "did:key:z6LSnotAnEd25519Key")))
    (is (nil? (root-auth/parse-did-key "did:key:zIl0O")))
    (is (nil? (root-auth/parse-did-key "did:web:example.com")))
    (is (nil? (root-auth/parse-did-key nil)))))

;; ----------------------------------------------------------------- root

(def ed25519-did fakes/ed25519-did)
(def sign-b64 fakes/sign-b64)
(def world fakes/world)
(def open-inbox fakes/open-inbox)
(def send-body fakes/send-body)

(deftest a-real-signature-verifies-and-a-transplanted-one-does-not
  (async done
    (-> (ed25519-did)
        (.then (fn [{:keys [kp did]}]
                 (let [msg (authz/challenge-string {:method :delete :path "/v1/inboxes/inbox_a"
                                                    :timestamp 1787000000 :nonce "n-1"})
                       other (authz/challenge-string {:method :delete :path "/v1/inboxes/inbox_b"
                                                      :timestamp 1787000000 :nonce "n-1"})]
                   (-> (sign-b64 kp msg)
                       (.then (fn [sig]
                                (-> (js/Promise.all
                                     #js [(root-auth/verify did sig msg)
                                          (root-auth/verify did sig other)
                                          (root-auth/verify did "bm90" msg)])
                                    (.then (fn [[ok transplanted garbage]]
                                             (is (true? ok))
                                             (is (false? transplanted)
                                                 "別の箱に対する署名が通ってはいけない")
                                             (is (false? garbage))
                                             (done)))))))))))))


;; ------------------------------------------------------------ 糸と invite

(defn- open! [w origin] (.then (open-inbox w origin) (fn [^js r] [(.-status r) r])))

(defn- send! [w {:keys [inbox key address]} to]
  (-> (send-body (:me w) {:address address :to to :subject "x" :text "y"})
      (.then (fn [body]
               (worker/handle-fetch
                (req :post (str "/v1/inboxes/" inbox "/messages")
                     :headers {"authorization" (str "Bearer " key)}
                     :body body)
                (:env w))))))

(defn- box!
  "開いて、example.com 向けの顔を 1 本出す。-> Promise<{:inbox :key :address}>"
  [w origin]
  (let [m* (atom nil)]
    (-> (open-inbox w origin)
        (.then json-of)
        (.then (fn [^js b]
                 (reset! m* (->clj b))
                 (worker/handle-fetch
                  (req :post (str "/v1/inboxes/" (:inbox @m*) "/personas")
                       :headers {"authorization" (str "Bearer " (:key @m*))}
                       :body {:party "example.com"})
                  (:env w))))
        (.then json-of)
        (.then (fn [^js b] (assoc @m* :address (.-address b)))))))

(deftest opening-needs-a-chain-and-an-invite
  (async done
    (let [{:keys [pub]} (x25519/generate-keypair)]
      (-> (worker/handle-fetch
           (req :post "/v1/inboxes" :body {:root "did:key:z6MkOwner" :pub (eseal/b64url pub)
                                           :origin "203.0.113.20"})
           (fake-env))
          (.then (fn [^js r] (is (= 400 (.-status r)) "糸の無い依頼で開けてはいけない") (json-of r)))
          (.then (fn [^js b]
                   (is (= "mail-relay.ito/missing-head" (.-error b)))
                   (world {})))
          (.then (fn [w]
                   ;; 許可リストに載っていない DID の invite
                   (aset (:env w) "RELAY_INVITER_ROOTS" "did:key:z6MkSomeoneElse")
                   (open-inbox w "203.0.113.21")))
          (.then (fn [^js r] (is (= 403 (.-status r))) (json-of r)))
          (.then (fn [^js b]
                   (is (= "mail-relay.ito/not-an-inviter" (.-error b)))
                   (done)))
          (.catch (fn [e] (is false (str "threw: " (.-message e))) (done)))))))

(deftest a-chain-signed-by-someone-else-is-refused
  ;; 糸の entry は root 本人の鍵で署名されていなければならない。招く側が
  ;; 招かれた側の entry に署名しても通らない。
  (async done
    (let [st (atom nil)]
      (-> (world {})
          (.then (fn [w]
                   (reset! st w)
                   (fakes/append! (:me w) {"type" "inbox/open" "at" (.now js/Date)
                                           "invite" (:invite w)})))
          (.then (fn [cid]
                   (.then (sign-b64 (:kp @(:inviter @st)) (ito/signing-message cid))
                          (fn [forged]
                            (swap! (:me @st) assoc-in [:sigs cid] forged)
                            (let [{:keys [pub]} (x25519/generate-keypair)]
                              (worker/handle-fetch
                               (req :post "/v1/inboxes"
                                    :body {:root (:did @(:me @st)) :pub (eseal/b64url pub)
                                           :origin "203.0.113.25"
                                           :ito (fakes/ito-body (:me @st) (:inviter @st))})
                               (:env @st)))))))
          (.then (fn [^js r] (is (= 403 (.-status r))) (json-of r)))
          (.then (fn [^js b]
                   (is (= "mail-relay.ito/bad-signature" (.-error b)))
                   (done)))
          (.catch (fn [e] (is false (str "threw: " (.-message e))) (done)))))))

(deftest invite-uses-come-from-the-chain-not-the-server
  (async done
    (let [st (atom nil)]
      (-> (world {:inboxes 1})
          (.then (fn [w] (reset! st w) (open-inbox w "203.0.113.30")))
          (.then (fn [^js r]
                   (is (= 201 (.-status r)) "1 回目は開ける")
                   (open-inbox @st "203.0.113.31")))
          (.then (fn [^js r] (is (= 403 (.-status r)) "2 回目は糸を数えると尽きている") (json-of r)))
          (.then (fn [^js b]
                   (is (= "mail-relay.ito/invite-used-up" (.-error b)))
                   (done)))
          (.catch (fn [e] (is false (str "threw: " (.-message e))) (done)))))))

(deftest a-refused-open-can-be-rebuilt-without-spending-the-invite
  ;; 枠で断られた entry を relay は見ていない。client はそれを捨てて前の head
  ;; から積み直せばよく、捨てたことは分岐の証拠にならない。
  (async done
    (let [st (atom nil) before (atom nil)]
      (-> (world {:inboxes 2})
          (.then (fn [w] (reset! st w) (open-inbox w "203.0.113.40")))
          (.then (fn [^js r]
                   (is (= 201 (.-status r)))
                   (reset! before (:head @(:me @st)))
                   (open-inbox @st "203.0.113.40")))
          (.then (fn [^js r] (is (= 409 (.-status r)) "同じ origin の 2 本目は枠で断られる") (json-of r)))
          (.then (fn [^js b]
                   (is (= "mail-relay/origin-slot-taken" (.-error b)))
                   ;; 断られた entry を捨てる
                   (swap! (:me @st) assoc :head @before)
                   (open-inbox @st "203.0.113.41")))
          (.then (fn [^js r]
                   (is (= 201 (.-status r)) "断られた試行は invite を使っていない")
                   (done)))
          (.catch (fn [e] (is false (str "threw: " (.-message e))) (done)))))))

(deftest a-fork-becomes-a-warrant-and-stops-the-root
  (async done
    (let [st (atom {})]
      (-> (world {:inboxes 3} :RESEND_API_KEY "re_test" :RESEND_FETCH (fakes/resend-send-ok))
          (.then (fn [w] (swap! st assoc :w w) (box! w "203.0.113.50")))
          (.then (fn [m]
                   (let [w (:w @st)]
                     (swap! st merge {:box m :fork-point (:head @(:me w))})
                     (send! w m ["a@example.com"]))))
          (.then (fn [^js r]
                   (is (= 202 (.-status r)) "1 通目は出る")
                   ;; 同じ位置から別の entry を署名して出す = 分岐
                   (swap! (:me (:w @st)) assoc :head (:fork-point @st))
                   (send! (:w @st) (:box @st) ["b@example.com"])))
          (.then (fn [^js r] (is (= 403 (.-status r))) (json-of r)))
          (.then (fn [^js b]
                   (is (= "mail-relay.ito/forked" (.-error b)))
                   (is (some? (.-warrant b)) "証拠を返す")
                   (worker/handle-fetch (req :get (str "/v1/ito/" (:did @(:me (:w @st)))))
                                        (:env (:w @st)))))
          (.then json-of)
          (.then (fn [^js b]
                   (is (some? (.-warrant b)) "warrant は公開され、他の relay が読める")
                   ;; 分岐を正しく積み直しても、もう通らない
                   (send! (:w @st) (:box @st) ["c@example.com"])))
          (.then (fn [^js r] (is (= 403 (.-status r)) "warrant のある root は止まったまま") (done)))
          (.catch (fn [e] (is false (str "threw: " (.-message e))) (done)))))))

(deftest a-replayed-head-cannot-send-twice
  (async done
    (let [st (atom {})]
      (-> (world {} :RESEND_API_KEY "re_test" :RESEND_FETCH (fakes/resend-send-ok))
          (.then (fn [w] (swap! st assoc :w w) (box! w "203.0.113.60")))
          (.then (fn [m]
                   (let [w (:w @st)]
                     (swap! st merge {:inbox (:inbox m) :key (:key m)})
                     (send-body (:me w) {:address (:address m) :to ["a@example.com"]
                                         :subject "x" :text "y"}))))
          (.then (fn [body]
                   (swap! st assoc :body body)
                   (worker/handle-fetch
                    (req :post (str "/v1/inboxes/" (:inbox @st) "/messages")
                         :headers {"authorization" (str "Bearer " (:key @st))} :body body)
                    (:env (:w @st)))))
          (.then (fn [^js r]
                   (is (= 202 (.-status r)))
                   ;; 同じ entry でもう 1 通
                   (worker/handle-fetch
                    (req :post (str "/v1/inboxes/" (:inbox @st) "/messages")
                         :headers {"authorization" (str "Bearer " (:key @st))} :body (:body @st))
                    (:env (:w @st)))))
          (.then (fn [^js r] (is (= 409 (.-status r))) (json-of r)))
          (.then (fn [^js b]
                   (is (= "mail-relay.ito/stale-head" (.-error b)))
                   (done)))
          (.catch (fn [e] (is false (str "threw: " (.-message e))) (done)))))))

(deftest first-contacts-are-budgeted-over-http
  (async done
    (let [st (atom {})
          cap (:mail-relay.ito/first-contacts-per-window ito/default-limits)]
      (-> (world {} :RESEND_API_KEY "re_test" :RESEND_FETCH (fakes/resend-send-ok))
          (.then (fn [w] (swap! st assoc :w w) (box! w "203.0.113.70")))
          (.then (fn [m]
                   (let []
                     (swap! st assoc :box m)
                     ;; 上限ちょうどまで、初めての相手に 1 人ずつ
                     (reduce (fn [p i]
                               (.then p (fn [_] (send! (:w @st) m [(str "p" i "@example.com")]))))
                             (js/Promise.resolve nil) (range cap)))))
          (.then (fn [^js r]
                   (is (= 202 (.-status r)) "上限ちょうどは通る")
                   (send! (:w @st) (:box @st) ["p0@example.com"])))
          (.then (fn [^js r]
                   (is (= 202 (.-status r)) "前に送った相手は何度でも")
                   (send! (:w @st) (:box @st) ["new@example.com"])))
          (.then (fn [^js r] (is (= 429 (.-status r))) (json-of r)))
          (.then (fn [^js b]
                   (is (= "mail-relay.ito/first-contact-budget-exhausted" (.-error b)))
                   (done)))
          (.catch (fn [e] (is false (str "threw: " (.-message e))) (done)))))))

;; ------------------------------------------------------ 端から端まで

(deftest open-issue-receive-read-and-send
  (async done
    (let [state (atom {})
          env* (atom nil)
          w* (atom nil)]
      (-> (world {} :RESEND_API_KEY "re_test" :RESEND_FETCH (fakes/resend-send-ok))
          (.then (fn [w]
                   (reset! env* (:env w))
                   (reset! w* w)
                   (open-inbox w "203.0.113.7")))
          (.then (fn [^js r] (is (= 201 (.-status r))) (json-of r)))
          (.then (fn [^js b]
                   (let [m (->clj b)]
                     (swap! state merge {:inbox (:inbox m) :key (:key m) :base (:address m)})
                     (testing "鍵はここでしか返らないと書いてある"
                       (is (str/starts-with? (str (:key m)) "rk_"))
                       (is (str/includes? (str (:note m)) "root"))))
                   (worker/handle-fetch
                    (req :post (str "/v1/inboxes/" (:inbox @state) "/personas")
                         :headers {"authorization" (str "Bearer " (:key @state))}
                         :body {:party "example.com"})
                    @env*)))
          (.then (fn [^js r] (is (= 201 (.-status r))) (json-of r)))
          (.then (fn [^js b]
                   (let [m (->clj b)]
                     (swap! state assoc :persona (:address m))
                     (is (str/ends-with? (str (:address m)) "@mail.itonami.cloud"))
                     (is (= 4 (count (str/split (first (str/split (str (:address m)) #"@")) #"-")))
                         "読み上げられる 4 語"))
                   (worker/save-raw! @env* {:to (:persona @state)
                                          :from "offers@example.com"
                                          :raw (message-to (:persona @state))
                                          :received-at "2026-08-28T00:00:00Z"})))
          (.then (fn [result]
                   (is (:stored result) (str "受信が落ちた: " (pr-str result)))
                   (worker/handle-fetch
                    (req :get (str "/v1/inboxes/" (:inbox @state) "/messages")
                         :headers {"authorization" (str "Bearer " (:key @state))})
                    @env*)))
          (.then (fn [^js r] (is (= 200 (.-status r))) (json-of r)))
          (.then (fn [^js b]
                   (let [messages (:messages (->clj b))
                         index (first messages)]
                     (is (= 1 (count messages)))
                     (testing "index に CID が付き、本文は入っていない"
                       (is (str/starts-with? (str (:cid index)) "bafkrei"))
                       (is (true? (:sealed index)))
                       (is (= "pass" (:spf index)))
                       (is (not (str/includes? (pr-str index) "本文")))
                       (is (not (str/includes? (pr-str index) "hello")))))
                   (worker/handle-fetch
                    (req :get (str "/v1/personas/" (:persona @state) "/senders")
                         :headers {"authorization" (str "Bearer " (:key @state))})
                    @env*)))
          (.then (fn [^js r] (is (= 200 (.-status r))) (json-of r)))
          (.then (fn [^js b]
                   (is (= ["example.com"] (:observed_senders (->clj b))))
                   (send-body (:me @w*) {:address (:persona @state)
                                         :to ["alice@example.com"]
                                         :subject "Re: hello"
                                         :text "こちらこそ"})))
          (.then (fn [body]
                   (worker/handle-fetch
                    (req :post (str "/v1/inboxes/" (:inbox @state) "/messages")
                         :headers {"authorization" (str "Bearer " (:key @state))}
                         :body body)
                    @env*)))
          (.then (fn [^js r] (is (= 202 (.-status r)) "送信が 202 で返らない") (json-of r)))
          (.then (fn [^js b]
                   (let [m (->clj b)]
                     (is (= (:persona @state) (:from m))
                         "From は persona が決めたもの。本体でも箱の base でもない")
                     (is (= "resend" (:provider m)))
                     (is (= "re_msg_1" (:message_id m))))
                   (done)))
          (.catch (fn [e] (is false (str "threw: " (.-message e) "\n" (.-stack e))) (done)))))))

(deftest a-caller-supplied-from-is-refused-over-http
  (async done
    (let [env* (atom nil)]
      (-> (world {} :RESEND_API_KEY "re_test" :RESEND_FETCH (fakes/resend-send-ok))
          (.then (fn [w]
                   (reset! env* (:env w))
                   (open-inbox w "203.0.113.9")))
          (.then json-of)
          (.then (fn [^js b]
                   (let [m (->clj b)]
                     (worker/handle-fetch
                      (req :post (str "/v1/inboxes/" (:inbox m) "/messages")
                           :headers {"authorization" (str "Bearer " (:key m))}
                           :body {:address (:address m) :from "jun@example.invalid"
                                  :to ["a@example.com"] :subject "x" :text "y"})
                      @env*))))
          (.then (fn [^js r] (is (= 400 (.-status r))) (json-of r)))
          (.then (fn [^js b]
                   (is (= "mail-relay.send/from-is-not-yours" (.-error b)))
                   (done)))
          (.catch (fn [e] (is false (str "threw: " (.-message e))) (done)))))))

(deftest root-routes-refuse-a-bare-did
  (async done
    (-> (worker/handle-fetch
         (req :delete "/v1/inboxes/inbox_a"
              :headers {"x-relay-root" "did:key:z6MkOwner"})
         (fake-env))
        (.then (fn [^js r]
                 (is (= 401 (.-status r))
                     "DID は公開の識別子。それだけで通ると誰でも他人の箱を閉じられる")
                 (json-of r)))
        (.then (fn [^js b]
                 (is (= "mail-relay.authz/missing-signature" (.-error b)))
                 (done))))))

(deftest threads-say-why-they-are-not-server-side
  (async done
    (let [env* (atom nil)]
      (-> (world {})
          (.then (fn [w]
                   (reset! env* (:env w))
                   (open-inbox w "203.0.113.11")))
          (.then json-of)
          (.then (fn [^js b]
                   (let [m (->clj b)]
                     (worker/handle-fetch
                      (req :get (str "/v1/inboxes/" (:inbox m) "/threads")
                           :headers {"authorization" (str "Bearer " (:key m))})
                      @env*))))
          (.then (fn [^js r] (is (= 501 (.-status r))) (json-of r)))
          (.then (fn [^js b]
                   (is (= "threads-are-client-side" (.-error b)))
                   (is (str/includes? (str (.-basis b)) "References")
                       "なぜサーバでは組めないかを言わずに 501 を返さない")
                   (done)))
          (.catch (fn [e] (is false (str "threw: " (.-message e))) (done)))))))

;; ------------------------------------------------------------- 布（relay の網）

(def urls ["https://r1.relay.test" "https://r2.relay.test" "https://r3.relay.test"])

(defn- ito-at [envs url did]
  (-> (worker/handle-fetch (req :get (str "/v1/ito/" did)) (get envs url))
      (.then json-of)
      (.then ->clj)))

(defn- relay-world
  "3 台の relay と、そこに箱を開ける利用者。-> Promise<{:envs :w}>"
  [inboxes]
  (let [envs (fakes/relays urls :RESEND_API_KEY "re_test" :RESEND_FETCH (fakes/resend-send-ok))]
    (.then (world {:inboxes inboxes})
           (fn [w]
             (fakes/set-all! envs :RELAY_INVITER_ROOTS (:did @(:inviter w)))
             {:envs envs :w w}))))

(deftest heads-spread-across-relays
  (async done
    (let [st (atom {})]
      (-> (relay-world 3)
          (.then (fn [m] (reset! st m)
                   (open-inbox (assoc (:w m) :env (get (:envs m) (first urls))) "203.0.113.80")))
          (.then (fn [^js r]
                   (is (= 201 (.-status r)))
                   (open-inbox (assoc (:w @st) :env (get (:envs @st) (second urls))) "203.0.113.81")))
          (.then (fn [^js r]
                   (is (= 201 (.-status r)) "r1 で開けた続きを r2 で積める")
                   (js/Promise.all (clj->js (map #(ito-at (:envs @st) % (:did @(:me (:w @st)))) urls)))))
          (.then (fn [arr]
                   (let [heads (map :head (vec arr))
                         me-head (:head @(:me (:w @st)))]
                     (is (every? #(= me-head %) heads) "3 台とも最新の head を持つ")
                     (is (not-any? :warrant (vec arr)) "正直な糸には warrant が無い"))
                   (done)))
          (.catch (fn [e] (is false (str "threw: " (.-message e) "\n" (.-stack e))) (done)))))))

(deftest a-fork-shown-to-two-relays-stops-the-root-on-every-relay
  ;; ADR-2610082200 P4 の合否条件を relay 3 台で: 糸の分岐の warrant が全台に
  ;; 届き、その網で作者が拒否される。
  (async done
    (let [st (atom {})
          at (fn [i] (assoc (:w @st) :env (get (:envs @st) (nth urls i))))]
      (-> (relay-world 3)
          (.then (fn [m] (reset! st m) (box! (at 0) "203.0.113.90")))
          (.then (fn [b1] (swap! st assoc :b1 b1) (box! (at 1) "203.0.113.91")))
          (.then (fn [b2]
                   (swap! st assoc :b2 b2 :fork-point (:head @(:me (:w @st))))
                   (send! (at 0) (:b1 @st) ["x@example.com"])))
          (.then (fn [^js r]
                   (is (= 202 (.-status r)) "r1 で 1 通出る")
                   ;; 同じ位置から別の entry を署名して、今度は r2 に見せる
                   (swap! (:me (:w @st)) assoc :head (:fork-point @st))
                   (send! (at 1) (:b2 @st) ["y@example.com"])))
          (.then (fn [^js r]
                   (is (= 403 (.-status r)) "r2 は r1 から届いた head と比べて分岐に気づく")
                   (js/Promise.all (clj->js (map #(ito-at (:envs @st) % (:did @(:me (:w @st)))) urls)))))
          (.then (fn [arr]
                   (is (every? :warrant (vec arr)) "warrant は 3 台すべてに届く")
                   (box! (at 2) "203.0.113.92")))
          (.then (fn [b3]
                   (is (nil? (:inbox b3)) "まだ箱の無い r3 でも開けない")
                   (done)))
          (.catch (fn [e] (is false (str "threw: " (.-message e) "\n" (.-stack e))) (done)))))))

(deftest a-forged-warrant-from-the-net-is-not-kept-or-spread
  (async done
    (let [st (atom {})]
      (-> (relay-world 3)
          (.then (fn [m]
                   (reset! st m)
                   ;; 招く側の鍵で、招かれた側の名前の 2 つの entry を作る
                   (let [me-did (:did @(:me (:w m)))
                         forger (:inviter (:w m))]
                     (-> (js/Promise.all
                          #js [(fakes/append! forger {"type" "mail/send" "at" (.now js/Date) "to" ["a@x.test"]} nil)
                               (fakes/append! forger {"type" "mail/send" "at" (.now js/Date) "to" ["b@x.test"]} nil)])
                         (.then (fn [arr]
                                  (let [[a b] (vec arr)]
                                    (worker/handle-fetch
                                     (req :post "/v1/nuno/ops"
                                          :body {:from "https://evil.test"
                                                 :op {:kind "warrant" :basis me-did :id "w:forged"
                                                      :payload {:actor me-did :seq 0 :a a :b b
                                                                :sigs (select-keys (:sigs @forger) [a b])
                                                                :blocks (select-keys (:blocks (fakes/ito-body forger)) [a b])}}})
                                     (get (:envs m) (first urls))))))))))
          (.then (fn [^js r] (json-of r)))
          (.then (fn [^js b]
                   (is (= "invalid" (.-verdict b)) "他人の entry を証拠にした warrant は偽物")
                   (js/Promise.all (clj->js (map #(ito-at (:envs @st) % (:did @(:me (:w @st)))) urls)))))
          (.then (fn [arr]
                   (is (not-any? :warrant (vec arr)) "どの relay も保管せず、流してもいない")
                   (done)))
          (.catch (fn [e] (is false (str "threw: " (.-message e) "\n" (.-stack e))) (done)))))))


(deftest a-warrant-with-entries-in-the-victims-name-but-the-wrong-key-is-rejected
  ;; actor は合っているが、署名が本人の鍵ではない証拠。署名を確かめなければ、
  ;; DID を知るだけで誰でも他人を網から締め出せてしまう。
  (async done
    (let [st (atom {})]
      (-> (relay-world 3)
          (.then (fn [m]
                   (reset! st m)
                   (let [me-did (:did @(:me (:w m)))
                         impostor (atom {:did me-did :kp (:kp @(:inviter (:w m)))
                                         :blocks {} :sigs {} :head nil})]
                     (-> (fakes/append! impostor {"type" "mail/send" "at" (.now js/Date) "to" ["a@x.test"]} nil)
                         (.then (fn [a] (.then (fakes/append! impostor {"type" "mail/send" "at" (.now js/Date)
                                                                         "to" ["b@x.test"]} nil)
                                               (fn [b] [a b]))))
                         (.then (fn [[a b]]
                                  (let [body (fakes/ito-body impostor)]
                                    (worker/handle-fetch
                                     (req :post "/v1/nuno/ops"
                                          :body {:from "https://evil.test"
                                                 :op {:kind "warrant" :basis me-did :id "w:impostor"
                                                      :payload {:actor me-did :seq 0 :a a :b b
                                                                :sigs (select-keys (:sigs body) [a b])
                                                                :blocks (select-keys (:blocks body) [a b])}}})
                                     (get (:envs m) (first urls))))))))))
          (.then json-of)
          (.then (fn [^js b]
                   (is (= "invalid" (.-verdict b)))
                   (js/Promise.all (clj->js (map #(ito-at (:envs @st) % (:did @(:me (:w @st)))) urls)))))
          (.then (fn [arr] (is (not-any? :warrant (vec arr))) (done)))
          (.catch (fn [e] (is false (str "threw: " (.-message e))) (done)))))))

(deftest a-head-from-the-net-with-a-bad-signature-is-not-held
  (async done
    (let [st (atom {})]
      (-> (relay-world 3)
          (.then (fn [m]
                   (reset! st m)
                   (let [me (:me (:w m))]
                     (.then (fakes/append! me {"type" "mail/send" "at" (.now js/Date) "to" ["a@x.test"]})
                            (fn [cid]
                              ;; 署名を別の鍵のものに差し替える
                              (.then (sign-b64 (:kp @(:inviter (:w m))) (ito/signing-message cid))
                                     (fn [forged]
                                       (swap! me assoc-in [:sigs cid] forged)
                                       (let [body (fakes/ito-body me)]
                                         (worker/handle-fetch
                                          (req :post "/v1/nuno/ops"
                                               :body {:from "https://evil.test"
                                                      :op {:kind "head" :basis (:did @me) :id cid
                                                           :payload body}})
                                          (get (:envs m) (first urls)))))))))))
          (.then json-of)
          (.then (fn [^js b]
                   (is (= "ignore" (.-verdict b)))
                   (ito-at (:envs @st) (first urls) (:did @(:me (:w @st))))))
          (.then (fn [m] (is (nil? (:head m)) "保持していない") (done)))
          (.catch (fn [e] (is false (str "threw: " (.-message e))) (done)))))))

;; ------------------------------------------------------------- 返信と receipt

(deftest a-reply-with-a-receipt-is-not-a-first-contact
  (async done
    (let [st (atom {})
          cap (:mail-relay.ito/first-contacts-per-window ito/default-limits)
          send-with (fn [to receipts]
                      ;; 断られた entry は relay が見ていないので捨てて、前の head に戻す
                      ;; （client が普通にすること）。
                      (let [{:keys [w box]} @st
                            before (:head @(:me w))]
                        (-> (send-body (:me w) {:address (:address box) :to to
                                                :subject "Re" :text "y" :receipts receipts})
                            (.then (fn [body]
                                     (worker/handle-fetch
                                      (req :post (str "/v1/inboxes/" (:inbox box) "/messages")
                                           :headers {"authorization" (str "Bearer " (:key box))}
                                           :body body)
                                      (:env w))))
                            (.then (fn [^js r]
                                     (when-not (.-ok r) (swap! (:me w) assoc :head before))
                                     r)))))]
      (-> (fakes/relay-signing-key)
          (.then (fn [rk]
                   (swap! st assoc :rk rk)
                   (world {} :RESEND_API_KEY "re_test" :RESEND_FETCH (fakes/resend-send-ok)
                          :RELAY_SIGNING_KEY (:pkcs8 rk) :RELAY_RECEIPT_DIDS (:did rk))))
          (.then (fn [w] (swap! st assoc :w w) (box! w "203.0.113.100")))
          (.then (fn [box]
                   (swap! st assoc :box box)
                   ;; 知らない人が先に書いてくる
                   (worker/save-raw! (:env (:w @st))
                                     {:to (:address box) :from "stranger@example.com"
                                      :raw (message-to (:address box))
                                      :received-at "2026-10-13T00:00:00Z"})))
          (.then (fn [_]
                   (worker/handle-fetch
                    (req :get (str "/v1/inboxes/" (:inbox (:box @st)) "/messages")
                         :headers {"authorization" (str "Bearer " (:key (:box @st)))})
                    (:env (:w @st)))))
          (.then json-of)
          (.then (fn [^js b]
                   (let [r (:receipt (first (:messages (->clj b))))]
                     (swap! st assoc :receipt r)
                     (is (= "stranger@example.com" (:from r)))
                     (is (= (:did @(:me (:w @st))) (:root r)) "receipt は箱の root を名指す")
                     (is (= (:did (:rk @st)) (:relay r)))
                     ;; receipt は relay の鍵で本当に署名されている
                     (root-auth/verify (:relay r) (:sig r)
                                       (ito/receipt-message (into {} (map (fn [[k v]] [(name k) v])) r))))))
          (.then (fn [ok?]
                   (is (true? ok?) "receipt の署名が relay の did:key で検証できる")
                   ;; 初めての相手で上限まで使い切る
                   (reduce (fn [p i] (.then p (fn [_] (send-with [(str "p" i "@example.com")] nil))))
                           (js/Promise.resolve nil) (range cap))))
          (.then (fn [^js r]
                   (is (= 202 (.-status r)))
                   (send-with ["stranger@example.com"] [(:receipt @st)])))
          (.then (fn [^js r]
                   (is (= 202 (.-status r)) "上限を使い切っても、先に書いてきた人には返信できる")
                   (send-with ["newbie@example.com"] [(:receipt @st)])))
          (.then (fn [^js r]
                   (is (= 429 (.-status r)) "receipt を付けても、書いてきた人以外は初めての相手")
                   ;; receipt の差出人を書き換える（署名はもう合わない）
                   (send-with ["mallory@example.com"]
                              [(assoc (:receipt @st) :from "mallory@example.com")])))
          (.then (fn [^js r] (is (= 403 (.-status r))) (json-of r)))
          (.then (fn [^js b]
                   (is (= "mail-relay.ito/bad-receipt" (.-error b)))
                   (done)))
          (.catch (fn [e] (is false (str "threw: " (.-message e) "\n" (.-stack e))) (done)))))))


(deftest a-head-from-the-net-with-a-forged-receipt-is-not-held
  ;; 網から来た head で保持した entry は、後の依頼で『確かめ済み』として扱われる。
  ;; ここで receipt を確かめないと、偽の receipt が網経由で予算をすり抜ける。
  (async done
    (let [st (atom {})]
      (-> (js/Promise.all #js [(fakes/relay-signing-key) (fakes/relay-signing-key)])
          (.then (fn [arr]
                   (let [[trusted forger] (vec arr)
                         envs (fakes/relays urls :RELAY_RECEIPT_DIDS (:did trusted))]
                     (swap! st assoc :envs envs :trusted trusted :forger forger)
                     (world {}))))
          (.then (fn [w]
                   (swap! st assoc :w w)
                   (let [me (:me w)
                         r {"type" "mail/receipt" "root" (:did @me) "from" "x@example.com"
                            "to" "me@mail.test" "msg" "bafkreiexample" "at" (.now js/Date)
                            ;; trusted を名乗るが、署名は偽の鍵
                            "relay" (:did (:trusted @st))}]
                     (-> (js/crypto.subtle.importKey "pkcs8" (root-auth/b64-decode (:pkcs8 (:forger @st)))
                                                     #js {:name "Ed25519"} false #js ["sign"])
                         (.then (fn [k] (js/crypto.subtle.sign #js {:name "Ed25519"} k
                                                               (.encode (js/TextEncoder.)
                                                                        (ito/receipt-message r)))))
                         (.then (fn [ab]
                                  (fakes/append! me {"type" "mail/send" "at" (.now js/Date)
                                                     "to" ["x@example.com"]
                                                     "receipts" [(assoc r "sig" (eseal/b64url (js/Uint8Array. ab)))]})))
                         (.then (fn [cid]
                                  (worker/handle-fetch
                                   (req :post "/v1/nuno/ops"
                                        :body {:from "https://evil.test"
                                               :op {:kind "head" :basis (:did @me) :id cid
                                                    :payload (fakes/ito-body me)}})
                                   (get (:envs @st) (first urls)))))))))
          (.then json-of)
          (.then (fn [^js b]
                   (is (= "ignore" (.-verdict b)))
                   (is (= "mail-relay.ito/bad-receipt" (str "mail-relay.ito/" (.-why b))))
                   (ito-at (:envs @st) (first urls) (:did @(:me (:w @st))))))
          (.then (fn [m] (is (nil? (:head m)) "保持していない") (done)))
          (.catch (fn [e] (is false (str "threw: " (.-message e) "\n" (.-stack e))) (done)))))))
